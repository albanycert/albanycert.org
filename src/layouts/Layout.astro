---
interface Props {
  title: string;
  description?: string;
}
import '../styles/global.css';
const path = Astro.url.pathname;
const here = (href: string) => (path === href || (href !== '/' && path.startsWith(href + '/')) ? 'page' : undefined);
const { title, description = 'Albany CERT — Community Emergency Response Team for Albany, California.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · Albany CERT</title>
  </head>
  <body>
    <header class="site">
      <nav class="site-nav">
        <a class="brand" href="/"><span class="mark" aria-hidden="true">CERT</span>Albany CERT</a>
        <ul>
          <li><a href="/about" aria-current={here("/about")}>About</a></li>
          <li><a href="/training" aria-current={here("/training")}>Training</a></li>
          <li><a href="/block-captains" aria-current={here("/block-captains")}>Block Captains</a></li>
          <li><a href="/radio-club" aria-current={here("/radio-club")}>Radio Club</a></li>
          <li><a href="/meetings" aria-current={here("/meetings")}>Meetings</a></li>
          <li><a href="/announcements" aria-current={here("/announcements")}>Announcements</a></li>
          <li><a href="/gallery" aria-current={here("/gallery")}>Gallery</a></li>
          <li><a href="/donate" class="donate" aria-current={here("/donate")}>Donate</a></li>
          <li><a href="/contact" aria-current={here("/contact")}>Contact</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Albany CERT is a 501(c)(3) nonprofit (EIN 86-2658175) supporting emergency
          preparedness in Albany, California, in partnership with the Albany Fire Department.
        </p>
        <p>
          <a href="mailto:AlbanyCERT@gmail.com">AlbanyCERT@gmail.com</a>
          ·
          <a href="https://groups.io/g/albanycert" target="_blank" rel="noopener">groups.io/g/albanycert</a>
        </p>
      </div>
    </footer>
  </body>
</html>
