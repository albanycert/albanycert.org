---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Albany CERT — Community Emergency Response Team for Albany, California.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · Albany CERT</title>
    <style>
      :root {
        --ink: #1a1a1a;
        --paper: #ffffff;
        --muted: #5a5a5a;
        --accent: #b3261e;
        --accent-dark: #7f1a14;
        --line: #e2e2e2;
        --max: 860px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.55;
      }
      a { color: var(--accent-dark); }
      a:hover { color: var(--accent); }
      header.site {
        border-bottom: 1px solid var(--line);
      }
      .wrap {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      .site-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.25rem;
        padding: 1rem 1.25rem;
        max-width: var(--max);
        margin: 0 auto;
      }
      .site-nav .brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--ink);
        text-decoration: none;
        margin-right: auto;
      }
      .site-nav ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        padding: 0;
        margin: 0;
      }
      .site-nav a {
        text-decoration: none;
        color: var(--ink);
        font-size: 0.95rem;
      }
      .site-nav a:hover { color: var(--accent); }
      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: 2rem 1.25rem 3rem;
      }
      footer.site {
        border-top: 1px solid var(--line);
        margin-top: 2rem;
      }
      footer.site .wrap {
        padding: 1.5rem 1.25rem;
        font-size: 0.9rem;
        color: var(--muted);
      }
      footer.site a { color: var(--muted); }
      h1 { font-size: 1.9rem; margin-top: 0; }
      h2 { font-size: 1.3rem; }
      img { max-width: 100%; height: auto; }
    </style>
  </head>
  <body>
    <header class="site">
      <nav class="site-nav">
        <a class="brand" href="/">Albany CERT</a>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/training">Training</a></li>
          <li><a href="/block-captains">Block Captains</a></li>
          <li><a href="/radio-club">Radio Club</a></li>
          <li><a href="/meetings">Meetings</a></li>
          <li><a href="/announcements">Announcements</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/donate">Donate</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          Albany CERT is a 501(c)(3) nonprofit (EIN 86-2658175) supporting emergency
          preparedness in Albany, California, in partnership with the Albany Fire Department.
        </p>
        <p>
          <a href="mailto:AlbanyCERT@gmail.com">AlbanyCERT@gmail.com</a>
          ·
          <a href="https://groups.io/g/albanycert" target="_blank" rel="noopener">groups.io/g/albanycert</a>
        </p>
      </div>
    </footer>
  </body>
</html>
