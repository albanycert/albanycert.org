---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const albums = (await getCollection('gallery')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });
---
<Layout title="Gallery">
  <h1>Gallery</h1>
  <p>Photo albums from CERT trainings, events, and meetings.</p>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1rem;">
    {albums.map((album) => (
      <a href={`/gallery/${album.id}`} style="text-decoration:none; color:inherit;">
        <img src={album.data.cover} alt={album.data.title} style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:4px;" />
        <p style="margin:0.35rem 0 0; font-size:0.95rem;">
          <strong>{album.data.title}</strong><br />
          <span style="color:var(--muted,#5a5a5a);">{dateFmt.format(album.data.date)} · {album.data.kind}</span>
        </p>
      </a>
    ))}
  </div>
</Layout>
